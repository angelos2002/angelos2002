# Public site URL (used for canonical URLs, sitemap, OG and schema)
NEXT_PUBLIC_SITE_URL=https://streetfoodrey.com

# Supabase — reviews, catering enquiries and job applications.
# Without these the site falls back to an in-memory demo store.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password for /el/admin and /en/admin (hide/unhide reviews)
ADMIN_PASSWORD=

# Salt used when hashing visitor IPs for rate limiting
REVIEW_IP_SALT=change-me
